# Extracao2 — .env de produção no servidor Samsung
# IMPORTANTE: Gere uma SECRET_KEY única com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=gere-uma-chave-secreta-unica-com-python-secrets-token_hex-32
DEBUG=False
ALLOWED_HOSTS=192.168.2.122,100.65.34.33,samsung,samsung.tailfc8a1a.ts.net,localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.prod

# Database (PostgreSQL + pgvector no Docker)
DATABASE_URL=postgresql://extracao2:extracao2_dev@db:5432/extracao2

# LLM (Ollama rodando como container no servidor via CasaOS)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b

# Embeddings (usar Ollama para embeddings no servidor CPU-only)
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text:latest

# Supabase Storage (se configurado — opcional para dev/prod local)
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_BUCKET_NAME=Via.extracao

# Extraction retries
EXTRACTION_MAX_RETRIES=2